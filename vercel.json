{
  "version": 2,
  "cleanUrls": true,
  "rewrites": [
    { "source": "/admin", "destination": "/admin.html" },
    { "source": "/api/admin-verify-pin", "destination": "/api/admin?action=verify-pin" },
    { "source": "/api/admin-dashboard", "destination": "/api/admin?action=dashboard" },
    { "source": "/api/admin-manage", "destination": "/api/admin?action=manage" },
    { "source": "/api/admin-roster", "destination": "/api/admin?action=roster" },
    { "source": "/api/admin-import-vendors", "destination": "/api/admin?action=import-vendors" },
    { "source": "/api/admin-export-results", "destination": "/api/admin?action=export-results" },
    { "source": "/api/admin-export-vendors", "destination": "/api/admin?action=export-vendors" },
    { "source": "/api/admin-export-roster", "destination": "/api/admin?action=export-roster" },
    { "source": "/api/admin-:action*", "destination": "/api/admin?action=:action" },
    { "source": "/api/admin/:action*", "destination": "/api/admin?action=:action" },
    { "source": "/((?!api/|.*\\..*).*)", "destination": "/index.html" }
  ]
}
