# Persekitaran Pelayan (development / production)
NODE_ENV=development
PORT=3000

# Sambungan PostgreSQL (contoh Supabase Transaction Pooler port 6543 atau direct port 5432)
# Format: postgresql://[user]:[password]@[host]:[port]/[database]?sslmode=require
DATABASE_URL=

# Rahsia Pentadbir (digunakan untuk pengesahan server-side endpoint /api/admin-*)
ADMIN_SECRET=

# Emel pentadbir untuk rekod jejak audit log
ADMIN_EMAIL=admin@kpmbp.edu.my
